<?xml version="1.0" encoding="UTF-8"?>
<!--
  ARCHITECT'S FIRELENS APPROACH — Logback config: CONSOLE (stdout) only.

  Log flow:
    SLF4J → Logback → CONSOLE (stdout JSON)
      → Firelens sidecar (aws-for-fluent-bit:3.3.0)
      → opentelemetry plugin → OTLP/HTTP :4318/v1/logs
      → OpenAPM OTel Collector → Loki

  No direct OTel appender here — Firelens handles log routing.

  KNOWN LIMITATION: logs reach Loki but service_name="unknown_service"
  because Firelens cannot set OTLP resource attributes (service.name).
  See docs/FIRELENS-EVIDENCE.md for full analysis.

  trace_id and span_id injected by Micrometer Tracing via MDC.
-->
<configuration>

    <!-- stdout JSON → picked up by Firelens sidecar → routed to Loki via OTLP -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <fieldNames>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
